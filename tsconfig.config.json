{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext"],
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true
  },
  "include": ["eslint.config.js"],
  "exclude": ["node_modules", "dist"]
}
