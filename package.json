{
  "name": "yuki-bot",
  "version": "2.0.0",
  "description": "A discord bot for managing google spreadsheets of puzzlehunts.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "slash": "tsx src/yuki/discord/deploy.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "author": "katian",
  "license": "ISC",
  "dependencies": {
    "@googleapis/drive": "^19.2.0",
    "@googleapis/sheets": "^12.0.0",
    "@js-temporal/polyfill": "^0.5.1",
    "chalk": "^5.6.2",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "google-auth-library": "^10.5.0",
    "googleapis": "^166.0.0",
    "puppeteer": "^24.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "gaxios": "^7.1.3",
    "prettier": "^3.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
