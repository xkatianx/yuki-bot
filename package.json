{
  "name": "yuki-bot",
  "version": "2.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "start": "npm run build && node dist/index.js",
    "slash": "npm run build && node dist/discord/commands/_deploy.js",
    "format": "prettier --check .",
    "test": "vitest",
    "lint": "eslint .",
    "check": "npm run format && npm run lint && npm run test"
  },
  "engines": {
    "node": "^22.6.0"
  },
  "type": "module",
  "author": "katian",
  "license": "ISC",
  "dependencies": {
    "@googleapis/drive": "~8.14.0",
    "@googleapis/sheets": "~9.3.0",
    "axios": "^1.11.0",
    "chalk": "^5.2.0",
    "discord.js": "^14.21.0",
    "dotenv": "^16.0.3",
    "google-auth-library": "~9.15.0",
    "moment": "^2.30.1",
    "puppeteer": "^24.16.2",
    "ts-results-es": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.6.0",
    "@types/uuid": "^9.0.7",
    "eslint": "^9.33.0",
    "gaxios": "^6.7.1",
    "prettier": "^3.2.5",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
